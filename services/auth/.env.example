PORT=3001
LOG_LEVEL=info
# En desarrollo el gateway corre en la misma máquina: confiamos en su X-Forwarded-For.
TRUST_PROXY=loopback
DATABASE_URL=postgres://ticketflow:ticketflow@localhost:5432/auth
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Clave Ed25519 para firmar access tokens (npm run keys -w @ticketflow/auth-service).
# Si queda vacía en desarrollo, se genera una efímera al arrancar.
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=10
