{
  "name": "@ticketflow/auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registro, login y emisión/rotación de tokens",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "keys": "tsx src/generate-key.ts",
    "build": "tsup",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@ticketflow/common": "0.1.0",
    "jose": "^6.2.15"
  }
}
