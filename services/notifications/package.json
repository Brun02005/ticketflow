{
  "name": "@ticketflow/notifications-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emails transaccionales con entradas (QR firmado), reintentos persistentes y backoff",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "build": "tsup",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ticketflow/common": "0.1.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4"
  }
}
